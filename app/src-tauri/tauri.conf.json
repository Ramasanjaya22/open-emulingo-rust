{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenKotoba",
  "version": "0.1.0",
  "identifier": "app.openkotoba.desktop",
  "build": {
    "beforeDevCommand": "pnpm -C ui dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm -C ui build",
    "frontendDist": "../ui/build"
  },
  "app": {
    "windows": [
      {
        "title": "OpenKotoba",
        "width": 1100,
        "height": 780,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
