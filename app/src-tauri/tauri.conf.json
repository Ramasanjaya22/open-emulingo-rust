{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenKotoba",
  "version": "0.1.0",
  "identifier": "dev.openkotoba.app",
  "build": {
    "frontendDist": "../ui/build",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm -C ../ui dev",
    "beforeBuildCommand": "pnpm -C ../ui build"
  },
  "app": {
    "windows": [
      {
        "title": "OpenKotoba",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"]
  }
}
